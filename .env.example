REACT_APP_SIGNATURE_CDN=https://okmg-signatures-assets.s3.ap-southeast-2.amazonaws.com/signatures

# Local manual sync only (npm run sync:s3) — not used by the app
AWS_S3_BUCKET=okmg-signatures-assets
AWS_REGION=ap-southeast-2

# Homepage client list password (leave empty to disable locally)
REACT_APP_HOME_PASSWORD=your-password-here
