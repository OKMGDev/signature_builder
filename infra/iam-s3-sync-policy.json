{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SignatureAssetSync",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::okmg-signatures-assets",
        "arn:aws:s3:::okmg-signatures-assets/signatures/*"
      ]
    }
  ]
}
